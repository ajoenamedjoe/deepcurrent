# UW Confluence Desk -- configuration
#
# You do NOT need this file if a sibling desk already has a .env next door.
# uw.py looks in ..\Swing Desk, ..\UW SwingDesk, ..\Institutional Desk,
# ..\UW Insider Desk and ..\GEX ES Desk before falling back to this folder,
# so the token and webhook live in exactly one place on the machine.
#
# Copy to ".env" only if you want settings that differ from the other desks.

UW_API_TOKEN=your-token-here

# Optional. Leave blank to run the board with no Discord posting at all.
# Private channel only: posting Unusual Whales data to other people (a public or paid server) may need a
# redistribution licence from Unusual Whales. Keep the webhook secret: anyone with it can post to your channel.
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------- scanning
# How far back to look for Form 4 open-market purchases. 45 days keeps the
# board fresh (~110 companies); 90 days is the longest that is still one
# rolling window rather than a history lesson (~225 companies).
CDESK_WINDOW_DAYS=45

# Sessions of dark pool history to score. One /api/darkpool/{ticker} call
# reaches back roughly 8 sessions for a small cap, so 10 is "everything the
# call returned" and lowering it makes thin and busy names comparable.
CDESK_DARK_SESSIONS=10

# Calendar days either side of an insider transaction date that a dark pool
# session still counts as "around" it.
CDESK_PROXIMITY_DAYS=5

# Ignore off-exchange prints smaller than this. The REST default is 0, which
# buries the blocks under thousands of odd lots.
CDESK_MIN_PRINT_PREMIUM=50000

# Cards below this never reach the board.
CDESK_MIN_SCORE=25

# Seconds between scans. Form 4s land in an evening wave and dark pool data
# is cached separately, so there is no point going faster than this.
CDESK_SCAN_SECONDS=600

# Cache lifetimes, seconds. Dark pool dominates API spend: at 1800 a full
# board of 110 names costs about 220 calls/hour.
CDESK_TTL_DARK=1800
CDESK_TTL_INSIDER=600

# Seconds between API calls, shared across all worker threads.
CDESK_MIN_INTERVAL=0.32
CDESK_WORKERS=5

# true = only show companies that are in the 13F small-fund universe.
# Default false, because the 13F leg is meant as a backdrop, not a gate.
CDESK_REQUIRE_INSTITUTIONAL=false

# ---------------------------------------------------------------- alerting
CDESK_ALERT_SCORE=70
CDESK_ALERT_STREAK=2
CDESK_ALERT_COOLDOWN_H=12
CDESK_ALERT_MAX=4

# true = only page when all three legs are contributing. This is a confluence
# desk; a 72 built entirely out of insider points is not the alert this desk
# exists for.
CDESK_ALERT_ALL_THREE=true

# ---------------------------------------------------------------- serving
CDESK_PORT=8770
CDESK_OPEN_BROWSER=true
