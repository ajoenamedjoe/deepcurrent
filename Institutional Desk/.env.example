# Institutional Desk configuration
#
# You do NOT need this file if "Swing Desk\.env" is still sitting next door --
# the app reads your token from there automatically. Copy this to ".env" only
# if you want to change a threshold.

# ---- credentials -----------------------------------------------------------
UW_API_TOKEN=your_unusual_whales_api_token

# ---- fund universe: the "smaller firms" half of the screen -----------------
# 13F portfolio value band. Below the floor is noise; above the ceiling you
# start getting institutions whose filings run for pages.
IDESK_FUND_MIN_AUM=50000000
IDESK_FUND_MAX_AUM=2500000000
# Hard cap on how many positions a fund may hold to stay in the universe.
IDESK_FUND_MAX_POSITIONS=75
# true  = only hedge funds and funds Unusual Whales has tagged
# false = every filer in the AUM band (roughly 8x more, mostly wealth RIAs)
IDESK_REQUIRE_HEDGE_FUND=true

# ---- company screen: smaller balance sheets, actually profitable -----------
IDESK_CO_MAX_MARKETCAP=10000000000
IDESK_CO_MAX_ASSETS=10000000000
# Consecutive profitable fiscal years required, counting back from the latest.
IDESK_MIN_PROFIT_YEARS=3

# ---- what counts as an alert ----------------------------------------------
IDESK_MIN_POSITION_VALUE=1000000
IDESK_MIN_ADD_PERC=0.25
IDESK_MAX_TRIM_PERC=-0.50
IDESK_CLUSTER_MIN_FUNDS=3

# ---- runtime ---------------------------------------------------------------
IDESK_PORT=8777
IDESK_OPEN_BROWSER=true
IDESK_SCAN_ON_START=false
# Parallel API workers and the global minimum gap between requests.
# Raise the interval if the API ever answers 429.
IDESK_WORKERS=5
IDESK_MIN_INTERVAL=0.32
# Ceiling on financial-statement lookups per scan (they are cached afterwards).
IDESK_MAX_FUNDAMENTAL_FETCHES=1200
IDESK_FUNDAMENTAL_MAX_AGE_DAYS=75
