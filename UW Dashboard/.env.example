# UW Dashboard settings. Copy to .env to change anything; everything is optional.
#
# The UW token is read from a sibling desk's .env (Valuation, Confluence, Swing,
# Institutional, or the Flow Desk folder -- configurable in Settings). Only set it here to override.
# UW_API_TOKEN=
#
# Port the dashboard serves on (desks use 8770-8790).
DASH_PORT=8700
#
# Set to 0 to never open a browser tab when the dashboard starts.
DASH_OPEN_BROWSER=1
#
# Published Google Sheet shown on the Portfolio page (can also be set in Settings).
# DASH_PORTFOLIO_URL=
