# UW Valuation Desk -- configuration
#
# You do NOT need this file if a sibling desk already has a .env next door:
# uw.py looks in ..\Swing Desk, ..\Institutional Desk, ..\Confluence Desk (and
# the other desks) before this folder, so the token lives in one place.
# Copy to ".env" only for settings that differ from the other desks.

UW_API_TOKEN=your-token-here

# Port for http://127.0.0.1:<port>/ -- Confluence Desk uses 8770.
VDESK_PORT=8790
VDESK_OPEN_BROWSER=true

# Seconds between API calls. A run is 4-6 calls.
VDESK_MIN_INTERVAL=0.32

# Foreign reporters. Statements arrive in the home currency while the quote is
# USD (TSM reports in TWD). Without a rate the desk REFUSES rather than mixing
# currencies. Units of that currency per 1 USD; update them yourself.
# VDESK_FX_TWD=32.0
# VDESK_FX_EUR=0.92
# VDESK_FX_JPY=148
