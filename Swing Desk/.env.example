# Copy this file to ".env" and fill in your values.

# Required. Unusual Whales API token (Settings -> API on unusualwhales.com)
UW_API_TOKEN=

# Optional. Discord webhook URL for high-conviction alerts.
# Private channel only: posting Unusual Whales data to other people (a public or paid server) may need a
# redistribution licence from Unusual Whales. Keep the webhook secret: anyone with it can post to your channel.
# In Discord: right-click your channel -> Edit Channel -> Integrations
#             -> Webhooks -> New Webhook -> Copy Webhook URL
DISCORD_WEBHOOK_URL=
