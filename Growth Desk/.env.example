# Growth Leaders (O'Neil-style) desk
# SETUP.bat writes this desk's .env with your Unusual Whales token. Without one, the token and the
# Discord webhook are read from a sibling desk's .env.

UW_API_TOKEN=

# Discord: posts only when a Leader (all seven checks) breaks out in a confirmed uptrend.
# Leave empty to use the shared DISCORD_WEBHOOK_URL from a sibling desk, or to post nothing.
# Private channel only: posting Unusual Whales data to other people (a public or paid server) may need a
# redistribution licence from Unusual Whales. Keep the webhook secret: anyone with it can post to your channel.
GDESK_DISCORD_WEBHOOK_URL=

# Port and browser (the dashboard sets GDESK_OPEN_BROWSER=0 when it starts the desk)
GDESK_PORT=8760
GDESK_OPEN_BROWSER=true

# Seconds between intraday breakout checks in market hours (one API call each)
GDESK_WATCH_SECONDS=900

# Seconds between API calls (raise if Unusual Whales ever answers 429)
GDESK_MIN_INTERVAL=0.34
