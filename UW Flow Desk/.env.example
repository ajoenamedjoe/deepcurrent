# UW Unusual Flow Desk

# Comments live on their OWN LINE, never beside a value.
# START_HERE.bat copies this file to .env verbatim, and the GEX ES Desk once
# shipped an example with an inline comment that made int() raise at import
# and crash the desk on every clean install. The parser strips them now, but
# the convention stays.

# Your Unusual Whales API token. This is the only line you have to fill in.
# Leave it blank and the desk borrows the token from a sibling desk's .env
# (Confluence Desk, Swing Desk, Institutional Desk, ...) if one is next door.
UW_TOKEN=

# Seconds between scans. Minimum 60, maximum 3600.
SCAN_SECONDS=300

# Local port for the board.
PORT=8733

# Pages of the contract screener to pull per scan, 250 rows each.
SCREENER_PAGES=2

# Extra premium floor on the contract screener, in dollars. 0 keeps the
# endpoint's own unusual preset ($10k).
MIN_CONTRACT_PREMIUM=0

# Open a browser tab on launch.
OPEN_BROWSER=true

# Scan outside 09:50-16:00 ET. Off by default: ask-side percentages early in
# the session are computed over a handful of prints and swing wildly, and
# nothing prints overnight.
SCAN_OUTSIDE_MARKET_HOURS=false
